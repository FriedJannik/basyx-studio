# 32 random bytes, base64url. Encrypts tokens and stored secrets at rest.
# Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
STUDIO_DATA_KEY=

# Another image, e.g. a local build: docker build -t basyx-studio:dev ../../..
# STUDIO_IMAGE=basyx-studio:dev
