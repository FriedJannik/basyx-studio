# Example values; replace every one of them.
POSTGRES_PASSWORD=change-me-postgres
STUDIO_DB_PASSWORD=change-me-studio
BASYX_DB_PASSWORD=change-me-basyx
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
# The confidential client secret of studio-web, shared by Keycloak (realm
# import) and Studio.
STUDIO_OIDC_CLIENT_SECRET=change-me-client-secret

